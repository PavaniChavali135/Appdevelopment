<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>location-services</string>
		<string>gps</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>

	<!-- ===================== Location permissions ===================== -->
	<!-- Shown when requesting "when in use" access. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app records your location periodically to build a personal heat map of the places you've visited.</string>

	<!-- Shown when requesting "always" (background) access. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Allow background access so the app can keep recording your location for the heat map even when it isn't open.</string>

	<!-- Legacy key kept for compatibility with older iOS versions. -->
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Allow background access so the app can keep recording your location for the heat map even when it isn't open.</string>

	<!-- Enables continued location updates while backgrounded. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
